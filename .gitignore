# Ignorar `results` por defecto, pero permitir subcarpetas canonicas (v11, docs).
results/*
!results/v11/
!results/v11/**
!results/v12/
!results/v12/**
!results/pgf_v10_documentacion_global/
!results/pgf_v10_documentacion_global/**

# Excluir solo archivos JSON grandes de results (mantener CSV y logs)
results/**/*.json
!results/**/metadata_template*.json
# EXCEPCIONES: JSONs de análisis y métricas son críticos
!results/**/analisis/*.json
!results/**/analisis_*.json
!results/**/*_metrics.json
!results/**/README*.md
!results/INDEX.md
!results/v11/F6/analysis/f6_pilot_selection_v11.json
!results/v11/F7/analysis/f7_pilot_selection_v11.json
!results/v11/RV1/rv1_invariants.json
!results/v11/RV2/rv2_invariants.json

